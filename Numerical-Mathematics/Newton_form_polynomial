def Divided_Differences(x,f):
    n = len(x) - 1

    a = np.zeros(n+1)

    for i in range(n+1):
        a[i] = f[i]     #Initialize the coefficient array
                        #Set all "coefficients" to the function
                        #at the node. 

    for j in range(1,n+1): # number of iterations = number of x and f values
                           # Also, the first coefficient remains untouched
        for i in range(n,j-1,-1): #Updates one fewer term each time
                                  # a_1 to a_n updated in the first iteration
                                  # a_2 to a_n in second iteration and so on. 
            a[i] = (a[i]-a[i-1])/(x[i]-x[i-j])
    return a

def Eval(x,y,t):
